# Copy to .env.local. Nothing here is required to run features 1 and 2.

# Place search: set to "true" to skip Nominatim and use bundled Metro Manila mock places.
VITE_USE_MOCK_PLACES=false

# Supabase (feature 4). Leave empty until the project exists; the app saves to localStorage meanwhile.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (feature 5, Vercel /api). Never prefix with VITE_.
ANTHROPIC_API_KEY=
AI_ENABLED=false
